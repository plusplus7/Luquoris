# DNS name reachable by the phone, with a valid publicly trusted TLS certificate.
LOQUIRIS_SERVER_HOST=transcribe.example.com
# Replace with at least 32 random characters; do not reuse the example token.
LOQUIRIS_CLIENT_TOKENS='{"phone":"REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"}'

# Enable the alternative only after preparing its explicit revision.
LOQUIRIS_ENABLED_PROFILES=qwen-1.7b

# Applied to new upload activity and terminal job retention.
LOQUIRIS_RETENTION_SECONDS=86400
LOQUIRIS_STAGE_TIMEOUT_SECONDS=3600
